@model EDE_TPLOCAL1.Models.FormModel
@using EDE_TPLOCAL1.Models




<!DOCTYPE html>
<html>

    <head>
        <title> HN - TP Local 1 </title>
        <link rel="stylesheet" href="~/resources/Form.css" />
    </head>



    <body>
        @{
            var entetePage = new EnteteMenuModel
            {
                Titre = "Formulaire TP HN avis",
                Rubriques = new List<RubriqueModel>
                        {
                            new RubriqueModel { Name = "Accueil", Url = "Home/Index" },
                            new RubriqueModel { Name = "Liste avis", Url = "Home/Index/OpinionList" }
                        }
            };
        }
        <partial name="EnteteMenu" model="entetePage" />

        <form asp-controller="Home"
              asp-action="ValidationFormulaire"
              method="post">
            <section class="SectionForm">

                <!-- Formulaire informations personnelles -->
                <div class="InfosPerso">
                    <h3> Informations personnelles </h3>
                    <table>
                        <tr>
                            <td> <label for="Nom"> Nom </label> </td>
                            <td>
                                <input type="text" id="Nom" name="Nom" value="@Model?.Nom" />
                                <span asp-validation-for="Nom" class="text-danger"> </span>
                            </td>
                        </tr>

                        <tr>
                            <td> <label for="Prenom"> Prénom </label> </td>
                            <td>
                                <input type="text" id="Prenom" name="Prenom" value="@Model?.Prenom" />
                                <span asp-validation-for="Prenom" class="text-danger"></span>
                            </td>
                        </tr>

                        <tr>
                            <td> <label for="Sexe"> Sexe </label> </td>
                            <td>
                                <select asp-for="Sexe">
                                    <option value=""> Sélectionner un sexe </option>
                                    <option value="Homme"> Homme </option>
                                    <option value="Femme"> Femme </option>
                                    <option value="Autre"> Autre </option>
                                </select>
                                <span asp-validation-for="Sexe" class="text-danger"></span>
                            </td>
                        </tr>
                        <tr>
                            <td> <label for="Adresse"> Adresse </label> </td>
                            <td>
                                <input type="text" id="Adresse" name="Adresse" value="@Model?.Adresse" />
                                <span asp-validation-for="Adresse" class="text-danger"></span>
                            </td>
                        </tr>
                        <tr>
                            <td> <label for="CodePostal"> Code Postal </label> </td>
                            <td>
                                <input type="text" id="CodePostal" name="CodePostal" pattern="[0-9]{5}" value="@Model?.CodePostal" />
                                <span asp-validation-for="CodePostal" class="text-danger"></span>
                            </td>
                        </tr>
                        <tr>
                            <td> <label for="Ville"> Ville </label> </td>
                            <td>
                                <input type="text" id="Ville" name="Ville" value="@Model?.Ville" />
                                <span asp-validation-for="Ville" class="text-danger"></span>
                            </td>
                        </tr>
                        <tr>
                            <td> <label for="AdresseMail"> Adresse Mail </label>     </td>
                            <td>
                                <input type="email" id="AdresseMail" name="AdresseMail" value="@Model?.AdresseMail" />
                                <span asp-validation-for="AdresseMail" class="text-danger"></span>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- Formulaire informations formation -->
                <div class="InfosFormation">
                    <h3> Informations formation suivie </h3>
                    <table>
                        <tr>
                            <td> <label for="DateDebutFormation"> Date début formation </label> </td>
                            <td>
                                <input type="date" id="DateDebutFormation" name="DateDebutFormation" asp-for="DateDebutFormation" />
                                <span asp-validation-for="DateDebutFormation" class="text-danger"></span>
                            </td>
                        </tr>
                        <tr>
                            <td> <label for="FormationSuivie"> Formation suivie </label> </td>
                            <td>
                                <select asp-for="FormationSuivie">
                                    <option value=""> Sélectionner une formation </option>
                                    <option value="Cobol"> Cobol </option>
                                    <option value="C#"> C# </option>
                                    <option value="Cobol & C#"> Double compétence </option>
                                </select>
                                <span asp-validation-for="FormationSuivie" class="text-danger"></span>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- Formulaire avis formation -->
                <div class="AvisFormation">
                    <h3> Avis sur la formation</h3>
                    <table>
                        <tr>
                            <td>
                                <label for="AvisFormationCobol"> Formation Cobol </label>
                            </td>
                            <td>
                                <textarea id="AvisFormationCobol"
                                          name="AvisFormationCobol"
                                          rows="1"
                                          asp-for="AvisFormationCobol">
                            </textarea>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <label for="AvisFormationCSharp"> Formation C# </label>
                            </td>
                            <td>
                                <textarea id="AvisFormationCSharp"
                                          name="AvisFormationCSharp"
                                          rows="1"
                                          asp-for="AvisFormationCSharp">
                            </textarea>
                            </td>
                        </tr>
                    </table>
                </div>

                <div class="Validation">
                    <button type="submit" class="bouton"> Valider </button>
                </div>
            </section>
        </form>
    </body>
</html>