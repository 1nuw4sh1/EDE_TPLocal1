@model List<EDE_TPLOCAL1.Models.Opinion>
@using EDE_TPLOCAL1.Models



<!DOCTYPE html>
<html>

    <head>
        <title> HN - TP Local 1 </title>
        <link rel="stylesheet" href="~/resources/OpinionList.css" />
    </head>

    <body>
        @{
            var entetePage = new EnteteMenuModel
            {
                Titre = "Liste des avis",
                Rubriques = new List<RubriqueModel>
                        {
                            new RubriqueModel { Name = "Accueil", Url = "Home/Index" },
                            new RubriqueModel { Name = "Formulaire", Url = "Home/Index/Form" }
                        }
            };
        }
        <partial name="EnteteMenu" model="entetePage" />

        <section class="SectionOpinionList">
            <h3> Liste </h3>
            <table>
                <thead>
                    <tr>
                        <th> Nom </th>
                        <th> Prénom </th>
                        <th> Avis donné </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var opinion in Model)
                    {
                        <tr>
                            <td> @opinion.LastName </td>
                            <td> @opinion.FirstName </td>
                            @if (opinion.OpinionGiven == "O")
                            {
                              <td class="Oui"> Oui </td>
                            }
                            else if (opinion.OpinionGiven == "N")
                            {
                                <td class="Non"> Non </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    </body>
</html>